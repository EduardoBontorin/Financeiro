@page "/sair"
@inherits Logoutpage
@layout HeadlessLayout

<PageTitle>Dima - Sair</PageTitle>

<MudText Typo="Typo.h3">Finalizando sessão...</MudText>

<MudPaper Class="pa-8 mt-4">
    <div class="d-flex justify-center pb-8 pt-8">
        <img src="images/dima.png" alt="Dima - Seu controle financeiro" width="200" />
    </div>
    <MudAlert Severity="Severity.Info">
        Sessão finalizada>
        <div>
            <MudButton Variant="Variant.Text" Href="/">IR PARA LOGIN</MudButton>
        </div>
    </MudAlert>
</MudPaper>