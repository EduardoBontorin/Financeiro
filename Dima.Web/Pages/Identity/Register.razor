@page "/comecar"
@layout HeadlessLayout
@inherits RegisterPage

<PageTitle>Dima - Entrar</PageTitle>

<MudGrid Justify="Justify.Center">
    <MudItem xs="12" sm="12" md="8" lg="6" xl="6" xxl="6">
        @* xs - extra small, xxl extra large *@
        <MudPaper Elevation="5" Class="mud-width-full pa-8">
            @* Padding all , posso colocar padding L,R,T  *@
            <div class="d-flex justify-center pb-8 pt-8">
                <img src="images/dima.png" alt="Dima - Controle financeiro" width="210" />
            </div>
            <EditForm Model="@InputModel" OnValidSubmit="OnValidSubmitAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <MudTextField T="string" Label="Email" 
                    InputType="InputType.Email" 
                    HelperText="Campo obrigatório" 
                    @bind-Value=InputModel.Email 
                    For="@(() => InputModel.Email)" />

                <MudTextField T="string" Label="Senha" 
                    InputType="InputType.Password" 
                    HelperText="Campo obrigatório" 
                    @bind-Value=InputModel.Password 
                    For="@(() => InputModel.Password)" />

                <div class="d-flex mt-8">
                    @if (IsBusy)
                    {
                        <MudProgressCircular Color="Color.Info" Indeterminate=true />
                    }
                    else
                    {
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled=IsBusy>Cadastrar</MudButton>
                        <MudSpacer />
                        <MudButton Variant="Variant.Outlined" Href="/login">Ja tenho uma conta</MudButton>
                    }
                </div>
            </EditForm>

        </MudPaper>
    </MudItem>
</MudGrid>



