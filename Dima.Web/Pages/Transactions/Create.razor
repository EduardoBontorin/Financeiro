@page "/lancamentos/novo"
@inherits CreateTransactionPage


<MudText Typo="Typo.h3"> Novo lançamento</MudText>
@*//TODO:Adicionar esqueleto enquanto isBusy *@
<MudPaper Class="pa-8 mt-4">
    <EditForm Model="InputModel" OnValidSubmit="OnValidSubmitAsync">
        <DataAnnotationsValidator/>

        <MudTextField Label="Título do lançamento" HelperText="Campo obrigatório" @bind-Value="InputModel.Title" For="@(()=> InputModel.Title)"></MudTextField>
        <MudTextField Label="Quanto ?" T="decimal" Format="C" HelperText="Informe o valor pago/recebido" Variant="Variant.Text" @bind-Value="InputModel.Amount" For="@(()=> InputModel.Amount)"></MudTextField>

        
        <div class="d-flex gap-3">
            
            <MudDatePicker ShowToolbar=false Label="Quando ?" @bind-Date="@InputModel.PaidOrReceivedAt" HelperText="Selecione a data pago/recebido"/>

            <MudSelect T="ETransactionType" AnchorOrigin="Origin.BottomLeft" Label="Tipo de movimentação" @bind-Value="@InputModel.Type">
                <MudSelectItem T="ETransactionType" Value="ETransactionType.Deposit">Entrada</MudSelectItem>
                <MudSelectItem T="ETransactionType" Value="ETransactionType.Withdraw">Saída</MudSelectItem>
            </MudSelect>

        </div>
        
        <MudSelect T="long" Label="Categoria" @bind-Value="InputModel.CategoryId" AnchorOrigin="Origin.BottomLeft">
            @foreach(var category in Categories)
            {
                <MudSelectItem T="long" Value="category.Id">@category.Title</MudSelectItem>
            }
        </MudSelect>
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4">Salvar</MudButton>
    </EditForm>
</MudPaper>
